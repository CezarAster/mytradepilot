{
  "name": "mytradepilot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "MyTradePilot: free trade analyzer plus the Referee, a local app that enforces your own trading rules on your Alpaca account.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:app": "vite --config vite.app.config.ts",
    "build:app": "vite build --config vite.app.config.ts",
    "start": "node src/server/main.ts",
    "referee": "node src/server/main.ts",
    "mcp": "node src/mcp/main.ts",
    "test": "node --test test/*.test.ts",
    "report": "node src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^12.11.1",
    "zod": "^4.6.5",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26"
  },
  "engines": {
    "node": ">=22.18"
  }
}
